# 依赖
node_modules/
.pnp
.pnp.js

# 构建产物
dist/
packaging/.build/
packaging/build_temp/
packaging/payload.zip
promo/downloads/*.exe

# Tauri 构建产物
src-tauri/target/
src-tauri/gen/
src-tauri/resources/

# 运行时数据（由应用运行时生成，不应入库）
workspaces.json
source/ws_*/

# 站点发布绑定（含本机绝对路径，由发布工具就地生成，不应入库）
.wbapp_*.genie

# Android 工程（apk/）：签名凭据与构建日志不入库
# （依赖/构建产物/apk 已由 apk/android/.gitignore 与根 node_modules/ 规则覆盖）
apk/android/keystore.properties
apk/build-*.log
*.jks
*.keystore

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 编辑器/系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 临时文件
*.tmp
*.bak
*~

# 本会话/临时清理区
.workbuddy/
_to_delete/

# 一次性脚本残留（历史遗留，勿再入库）
*.b64
build-log*
c1.txt
c2.txt
p1.txt
py_out.txt
chunk.txt
long_test.txt
