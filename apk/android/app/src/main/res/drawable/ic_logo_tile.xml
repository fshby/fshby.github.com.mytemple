<?xml version="1.0" encoding="utf-8"?>
<!--
  品牌方牌（cube）：深色圆角底 + 米色标记，与 cloud/icon.svg 逐值一致（64 视口）。
  启动画面用它而非 ic_launcher_foreground：启动底色在浅色模式是 #f6f4ef、
  深色模式是 #12100e，而标记本身是米色 —— 直接放在浅色底上几乎看不见。
  套一层品牌色方牌后，两种底色下都有足够对比。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="64dp"
    android:height="64dp"
    android:viewportWidth="64"
    android:viewportHeight="64">

