{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "promo",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/downloads/(.*\\.exe)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"$1\""
        }
      ]
    }
  ]
}
